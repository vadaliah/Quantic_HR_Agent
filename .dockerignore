!Dockerfile.render
!pyproject.toml
!uv.lock
!src
!web
!evaluation
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/**
**/__pycache__
**/*.pyc
**/*.egg-info
# Copy to .env for local shells. Do not commit .env or secret values.
# Cost-first: leave QUANTIC_ALLOW_AWS_DEPLOY unset. Local app uses DATABASE_URL only.
DATABASE_URL=postgresql://quantic@127.0.0.1:5433/quantic_hr
QUANTIC_RUNTIME=local
AWS_PROFILE=AEA-Sandbox-PowerUser
AWS_REGION=us-east-2
EXPECTED_ACCOUNT=287238357427
CDK_DEFAULT_ACCOUNT=287238357427
CDK_DEFAULT_REGION=us-east-2
QUANTIC_PROJECT=quantic-hr-agent
QUANTIC_STACK_NAME=QuanticHrAgentStack
QUANTIC_DATABASE_MODE=create
QUANTIC_DATABASE_NAME=quantic_hr
QUANTIC_SECRET_NAME=quantic-hr-agent/dev/database/admin
# One chat model at a time. Must match the CDK context quanticChatModel
# (infrastructure/lib/config.ts chatModels) so the runtime role allows it.
# Default: Claude Sonnet 4.6. Alternative: us.amazon.nova-pro-v1:0 with
# -c quanticChatModel=nova-pro (check Nova Pro access in the account first).
BEDROCK_CHAT_INFERENCE_PROFILE=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
QUANTIC_HELLO_WORLD_RUNTIME=QuanticHelloWorld
